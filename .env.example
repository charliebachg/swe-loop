# Copy to .env. Never commit .env.
# Without DEVIN_API_KEY the app runs in replay mode from committed fixtures.
DEVIN_API_KEY=
DEVIN_ORG_ID=
GITHUB_TOKEN=
SWE_LOOP_MODE=replay            # replay | live
SWE_LOOP_CONFIG=configs/superset-pandas3.yaml
SWE_LOOP_DB=data/live/swe_loop.sqlite
SWE_LOOP_REPLAY_DIR=data/replay
